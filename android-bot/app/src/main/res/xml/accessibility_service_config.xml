<?xml version="1.0" encoding="utf-8"?>
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200" />
    <!-- ATTENTION : pas de restriction "packageNames" ici volontairement.
         Le nom du paquet qui affiche la boîte de dialogue USSD varie selon
         le fabricant (com.android.phone sur AOSP/Pixel, mais souvent
         différent sur Samsung/Tecno/Infinix très répandus au Bénin). Il
         faudra identifier le bon package sur TON device précis (voir
         README section "Calibrage") et le renseigner ici pour limiter la
         charge du service aux seules fenêtres pertinentes. -->
